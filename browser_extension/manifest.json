{
  "manifest_version": 3,
  "name": "BossPilot 一键采集",
  "version": "0.1.0",
  "description": "从 Boss 直聘页面采集可见文本，支持单次发送和求职会话监控上传。",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://zhipin.com/*",
    "https://www.zhipin.com/*",
    "https://*.zhipin.com/*"
  ],
  "action": {
    "default_title": "BossPilot 一键采集",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://zhipin.com/*",
        "https://www.zhipin.com/*",
        "https://*.zhipin.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
